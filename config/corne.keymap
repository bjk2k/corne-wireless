// ZMK Studio support disabled: removed zmk,physical-layout and reserved extras
// Keymap Editor compatibility: added matrix-transform

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    chosen { zmk,matrix-transform = &five_column_transform; };

    behaviors {
        mtl: mtl {
            compatible = "zmk,behavior-hold-tap";
            label = "MTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <25 26 27 28 29 19 18 17 16 15 5 6 7 9 8>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
        };

        mtr: mtr {
            compatible = "zmk,behavior-hold-tap";
            label = "MTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            hold-trigger-key-positions = <24 23 22 21 20 10 12 13 14 4 3 2 1 11 0>;
            quick-tap-ms = <175>;
            hold-trigger-on-release;
            flavor = "balanced";
        };

        tap_dance_paranthesis: tap_dance_paranthesis {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_PARANTHESIS";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        lt_repeat: lt_repeat {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_REPEAT";
            bindings = <&tog>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <125>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        ultimate-mod {
            bindings = <&sk LC(Q)>;
            key-positions = <30 35>;
            slow-release;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q                &kp W              &kp F                          &kp P                           &kp B               &kp J           &kp L             &kp U             &kp Y      &kp SEMICOLON  &mtl LGUI A             &mtl LEFT_ALT R
&mtl LEFT_CONTROL S  &mtl LEFT_SHIFT T  &mtl LA(LC(LG(LEFT_SHIFT))) G  &mtr RA(RC(RG(RIGHT_SHIFT))) M  &mtr RIGHT_SHIFT N  &mtr RCTRL E    &mtr RIGHT_ALT I  &mtr RIGHT_GUI O  &kp Z      &kp X          &kp C                   &kp D
&kp V                &kp K              &kp H                          &kp COMMA                       &kp PERIOD          &kp SLASH       &lt 5 ESCAPE      &lt 3 SPACE       &lt 4 TAB  &lt 1 RET      &lt_repeat 2 BACKSPACE  &kp ESCAPE
            >;
        };

        symbols {
            bindings = <
&kp LS(LBRC)   &kp LS(AMPS)   &kp LS(STAR)  &kp ASTERISK  &kp LS(RBRC)  &trans    &trans            &trans                  &trans         &trans        &kp LS(COLON)  &kp LS(DLLR)
&kp LS(PRCNT)  &kp LS(CARET)  &kp LS(PLUS)  &trans        &trans        &trans    &trans            &trans                  &kp LS(TILDE)  &kp LS(EXCL)  &kp LS(AT)     &kp LS(POUND)
&kp LS(PIPE)   &trans         &trans        &trans        &trans        &trans    &kp SINGLE_QUOTE  &tap_dance_paranthesis  &kp LS(UNDER)  &trans        &trans         &trans
            >;
        };

        numbers {
            bindings = <
&kp LBKT  &kp N7  &kp N8     &kp N9  &kp RBKT  &trans    &trans  &trans  &trans     &trans  &kp SEMI  &kp N4
&kp N5    &kp N6  &kp EQUAL  &trans  &trans    &trans    &trans  &trans  &kp GRAVE  &kp N1  &kp N2    &kp N3
&kp BSLH  &trans  &trans     &trans  &trans    &trans    &to 0   &kp N0  &kp MINUS  &trans  &trans    &trans
            >;
        };

        nav {
            bindings = <
&trans  &trans    &trans     &trans     &trans    &kp LG(Y)    &kp LG(V)  &kp LG(C)  &kp LG(X)  &kp LG(Z)  &trans  &trans
&trans  &trans    &trans     &kp LEFT   &kp DOWN  &kp UP       &kp RIGHT  &kp ESC    &trans     &trans     &trans  &trans
&trans  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END   &kp DEL      &trans     &trans     &trans     &trans     &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans          &trans          &trans          &trans           &trans           &trans           &trans  &trans  &trans     &trans     &trans
&trans  &trans          &trans          &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT  &trans  &trans  &trans     &trans     &trans
&trans  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT  &kp BACKSPACE    &trans           &trans  &trans  &mkp RCLK  &mkp LCLK  &trans
            >;
        };

        device_mgmt {
            bindings = <
&trans  &trans  &trans  &trans        &trans        &trans          &bt BT_CLR    &trans        &trans  &trans  &trans  &trans
&trans  &trans  &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans        &trans        &trans          &trans        &trans        &trans  &trans  &trans  &trans
            >;
        };
    };
};
