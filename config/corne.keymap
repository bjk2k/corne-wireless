// ZMK Studio support disabled: removed zmk,physical-layout and reserved extras
// Keymap Editor compatibility: added matrix-transform

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,matrix-transform = &five_column_transform; };

    behaviors {
        mtl: mtl {
            compatible = "zmk,behavior-hold-tap";
            label = "MTL";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <25 26 27 28 29 19 18 17 16 15 5 6 7 9 8>;
            tapping-term-ms = <200>;
        };

        mtr: mtr {
            compatible = "zmk,behavior-hold-tap";
            label = "MTR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            hold-trigger-key-positions = <24 23 22 21 20 10 12 13 14 4 3 2 1 11 0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q                &kp W              &kp F  &kp P      &kp B               &kp J           &kp L             &kp U             &kp Y    &kp SEMICOLON  &mtl LGUI A    &mtl LEFT_ALT R
&mtl LEFT_CONTROL S  &mtl LEFT_SHIFT T  &kp G  &kp M      &mtr RIGHT_SHIFT N  &mtr RCTRL E    &mtr RIGHT_ALT I  &mtr RIGHT_GUI O  &kp Z    &kp X          &kp C          &kp D
&kp V                &kp K              &kp H  &kp COMMA  &kp PERIOD          &kp SLASH       &kp LGUI          &kp SPACE         &kp TAB  &kp RET        &kp BACKSPACE  &kp BSPC
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&kp EXCL      &kp AT        &kp HASH      &kp DLLR  &kp PRCNT  &kp CARET    &kp AMPS   &kp KP_MULTIPLY  &kp LPAR    &kp RPAR  &bt BT_SEL 0  &bt BT_SEL 1
&bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LEFT  &kp DOWN   &kp UP       &kp RIGHT  &trans           &bt BT_CLR  &trans    &trans        &trans
&trans        &trans        &trans        &trans    &trans     &trans       &kp LGUI   &trans           &kp SPACE   &kp RET   &kp ESC       &kp TAB
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&kp N1     &kp N2    &kp N3    &kp N4     &kp N5    &kp N6      &kp N7    &kp N8    &kp N9     &kp N0   &kp MINUS  &kp EQUAL
&kp LBRC   &kp LBKT  &kp LPAR  &kp RPAR   &kp RBKT  &kp RBRC    &kp FSLH  &kp BSLH  &kp GRAVE  &trans   &trans     &kp COMMA
&kp COLON  &kp SEMI  &kp DOT   &kp LCTRL  &kp RALT  &trans      &kp LGUI  &kp ESC   &kp SPACE  &kp RET  &trans     &kp TAB
            >;
        };
    };
};
